# Terraform variables for the dev environment
project        = "ha-webapp"
environment    = "dev"
vpc_cidr_block = "10.69.129.0/24"
region         = "us-east-1"
azs            = ["us-east-1a", "us-east-1b"]
instance_type  = "t3.micro"
asg_min_size   = 2
asg_max_size   = 4
enable_waf     = null
emails_list    = ["john.doe@example.com"]
